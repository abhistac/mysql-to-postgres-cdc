# Copy to .env and adjust for your environment.
# Defaults match what docker-compose.yml falls back to when .env is absent,
# so the stack runs out of the box without any setup.

# ── MySQL (source) ────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpwd
MYSQL_DEBEZIUM_USER=debezium
MYSQL_DEBEZIUM_PASSWORD=dbz

# ── PostgreSQL (sink) ─────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mydb
