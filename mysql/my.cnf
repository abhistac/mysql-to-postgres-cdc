[mysqld]
# Required for Debezium to read the MySQL binary log (binlog).
# server-id must be unique if this MySQL is part of a replication topology.
server-id         = 223344
log_bin           = mysql-bin
binlog_format     = ROW
binlog_row_image  = FULL

# GTID disabled — Debezium works with both GTID and non-GTID setups.
# Keeping off simplifies the demo; enable for production replication setups.
gtid_mode               = OFF
enforce_gtid_consistency = OFF

character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
